// Moneymap — Database Schema
// Stack: Supabase (PostgreSQL) + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USUÁRIO ──────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  transactions Transaction[]
  categories   Category[]
  rules        CategoryRule[]
  cards        Card[]
  pdfUploads   PdfUpload[]

  @@map("users")
}

// ─── CONTAS BANCÁRIAS ─────────────────────────────────────────────────────────
model Account {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  bank            BankType
  type            AccountType
  pluggyItemId    String?
  pluggyAccountId String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  transactions Transaction[]
  cards        Card[]
  pdfUploads   PdfUpload[]

  @@index([userId])
  @@map("accounts")
}

// ─── CARTÕES ──────────────────────────────────────────────────────────────────
model Card {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nickname   String
  lastFour   String    @db.Char(4)
  brand      CardBrand
  closingDay Int
  dueDay     Int
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  transactions Transaction[]

  @@index([userId])
  @@index([accountId])
  @@map("cards")
}

// ─── CATEGORIAS ───────────────────────────────────────────────────────────────
model Category {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String?
  color     String?
  isDefault Boolean    @default(false)
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")

  transactions Transaction[]
  rules        CategoryRule[]

  @@map("categories")
}

// ─── REGRAS DE CATEGORIZAÇÃO AUTOMÁTICA ──────────────────────────────────────
model CategoryRule {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  pattern    String
  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("category_rules")
}

// ─── TRANSAÇÕES ───────────────────────────────────────────────────────────────
model Transaction {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  cardId     String?
  card       Card?     @relation(fields: [cardId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Dados financeiros
  amount        Decimal           @db.Decimal(12, 2)
  type          TransactionType
  description   String
  date          DateTime          @db.Date
  paymentMethod PaymentMethod
  status        TransactionStatus @default(pendente)

  // Recorrência
  isFixed           Boolean @default(false)
  installmentNumber Int?
  installmentsTotal Int?
  recurringGroupId  String?

  // Extras
  isPending Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, accountId])
  @@index([recurringGroupId])
  @@map("transactions")
}

// ─── UPLOADS DE PDF ───────────────────────────────────────────────────────────
model PdfUpload {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id])
  fileName     String
  storagePath  String
  bank         BankType
  periodStart  DateTime     @db.Date
  periodEnd    DateTime     @db.Date
  status       UploadStatus @default(processing)
  parsedCount  Int?
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("pdf_uploads")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────
enum BankType {
  nubank
  mercadopago
  picpay
  btg
  other
}

enum AccountType {
  conta_digital
  cartao_credito
  cartao_debito
  investimento
}

enum CardBrand {
  visa
  mastercard
  elo
  hipercard
  amex
  other
}

enum TransactionType {
  entrada
  saida
}

enum PaymentMethod {
  pix
  boleto
  credito
  debito
  dinheiro
  transferencia
}

enum TransactionStatus {
  pendente
  pago
  agendado
}

enum UploadStatus {
  processing
  completed
  failed
}
